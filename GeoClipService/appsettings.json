{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Username=postgres;Password=postgres;Database=GeoClip;IncludeErrorDetail=true",
    "HangfireConnection": "Host=localhost;Port=5433;Username=postgres;Password=postgres;Database=GeoClip;"
  },
  "S3": {
    "RootUser": "recognition",
    "RootPassword": "recognition_password",
    "AccessKeyId": "recognition",
    "SecretAccessKey": "recognition_password",
    "EndpointUrl": "http://51.250.115.228:9000",
    "PublicEndpoint": "http://51.250.115.228:9000",
    "BucketName": "recognition",
    "RegionName": "us-east-1",
    "SignatureVersion": "s3v4",
    "ForcePathStyle": true
  },
  "Yolo": {
    "ModelPath": "wwwroot/model_data/yolo.onnx",
