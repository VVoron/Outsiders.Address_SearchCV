    "ConfThreshold": 0.25,
    "IouThreshold": 0.45,
    "FovDeg": 90.0
  },
  "Predict": {
    "ModelPath": "wwwroot/model_data/geo_clip_model.onnx",
    "UseCudaIfAvailable": true,
    "ModelInputName": "image",

    "Center": {
      "Lat": 55.7558,
      "Lon": 37.6173
    },

    "Preprocess": {
      "ImageSize": 224,
      "Mean": [0.485, 0.456, 0.406],
      "Std":  [0.229, 0.224, 0.225]
    },

    "Earth": {
      "RadiusMeters": 6378137.0
    }
  }
